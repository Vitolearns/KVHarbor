digraph architecture {
  // Generate both languages and themes with scripts/render_readme_architecture.py.
  graph [rankdir=TB, bgcolor=transparent, pad=0.14, nodesep=0.18, ranksep=0.23,
         splines=polyline, ordering=out];
  node [shape=box, style="rounded,filled", fixedsize=true, fontname="DejaVu Sans", fontsize=18,
        fontcolor="#17283A", fillcolor="#FCFDFF", color="#C7D7E3", penwidth=1.2,
        margin="0.21,0.15"];
  edge [color="#56798E", penwidth=1.5, arrowsize=0.66];

  http [label="HTTP API", width=2.35, height=0.53];
  admission [label="C++20 request scheduler\nQueues · Workers · Cancellation",
             width=5.02, height=0.77, fillcolor="#EAF1F7"];
  text [label="Text generation\nGPU · Text queue\nllama.cpp or\nTensorRT Edge-LLM\nSSE text stream",
        width=3.55, height=1.76, fillcolor="#EDF6FC"];
  speech [label="Speech\nCPU · Separate task queues\nsherpa-onnx\nQwen3-ASR → JSON\nKokoro → PCM16",
          width=3.55, height=1.76, fillcolor="#EAF6F2"];
  http -> admission;
  admission -> text;
  admission -> speech;
  { rank=same; text; speech; }
}
